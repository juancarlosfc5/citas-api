DB_HOST=localhost
DB_PORT=3306
DB_NAME=citas_fcv_training
DB_USER=citas_app
DB_PASSWORD=CHANGE_ME
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
FRONTEND_ORIGIN=http://localhost:5173
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax

# n8n Cloud: cada workflow recibe su propia URL y Bearer. No copiar valores reales aquí.
# WF-001 y WF-003 están reservados para futuros callbacks; S5 usa actualmente solo WF-002.
N8N_REMINDERS_WEBHOOK_ENABLED=false
N8N_REMINDERS_WEBHOOK_URL=
N8N_REMINDERS_WEBHOOK_BEARER_TOKEN=

N8N_STATUS_WEBHOOK_ENABLED=false
N8N_STATUS_WEBHOOK_URL=
N8N_STATUS_WEBHOOK_BEARER_TOKEN=
N8N_STATUS_WEBHOOK_CONNECT_TIMEOUT_MS=3000
N8N_STATUS_WEBHOOK_READ_TIMEOUT_MS=5000

N8N_DAILY_SUMMARY_WEBHOOK_ENABLED=false
N8N_DAILY_SUMMARY_WEBHOOK_URL=
N8N_DAILY_SUMMARY_WEBHOOK_BEARER_TOKEN=
