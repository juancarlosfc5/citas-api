#!/usr/bin/env sh
set -eu

old_ifs=$IFS
IFS='
'
for file in $(git diff --cached --name-only --diff-filter=ACM); do
  [ "$file" = ".env.example" ] && continue
  if git show ":$file" | grep -Eiq '(JWT_(ACCESS|REFRESH)_SECRET|DB_PASSWORD|MYSQL_ROOT_PASSWORD|OAUTH_CLIENT_SECRET)[[:space:]]*[:=][[:space:]]*[^$[:space:]][^[:space:]]*'; then
    printf '%s\n' "Se detectó un secreto potencial en $file. Retíralo antes de confirmar."
    exit 1
  fi
done
IFS=$old_ifs

if command -v mvn >/dev/null 2>&1; then
  mvn test
else
  docker compose -f compose.test.yml run --rm api-test mvn test -q
fi
